# Clerk Authentication
# Get these from https://dashboard.clerk.com/
CLERK_SECRET_KEY=sk_test_xxxx
CLERK_PUBLISHABLE_KEY=pk_test_xxxx

# Clerk API version (optional, defaults to v1)
# CLERK_API_VERSION=v1

# Clerk API URL (optional, auto-derived from publishable key)
# CLERK_API_URL=https://api.clerk.com

# Allowed CORS origin (frontend URL)
ALLOWED_ORIGIN=http://localhost:3000

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/agent_dragon_inn"

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# Node environment
NODE_ENV=development
