// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// User (managed by Clerk, synced via webhooks)
// ============================================================
model User {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String   @unique
  name          String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  organizationMemberships OrganizationMember[]
  createdAgents           Agent[]
  createdWorkflows        Workflow[]
  executions             Execution[]
  createdApiKeys         ApiKey[]
  auditLogs             AuditLog[]

  @@map("users")
}

// ============================================================
// Organization
// ============================================================
model Organization {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String   @unique
  plan      Plan     @default(FREE)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  members        OrganizationMember[]
  agents         Agent[]
  workflows      Workflow[]
  executions     Execution[]
  apiKeys        ApiKey[]
  auditLogs      AuditLog[]

  @@map("organizations")
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

// ============================================================
// OrganizationMember (join table with roles)
// ============================================================
model OrganizationMember {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           OrgRole          @default(MEMBER)
  joinedAt       DateTime         @default(now()) @map("joined_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("organization_members")
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

// ============================================================
// Agent
// ============================================================
model Agent {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  name           String
  description    String?       @db.Text
  modelProvider  ModelProvider
  modelName      String        @map("model_name")
  systemPrompt   String?       @map("system_prompt") @db.Text
  temperature    Float         @default(0.7)
  maxTokens      Int?          @map("max_tokens")
  config         Json          @default("{}")
  isActive       Boolean       @default(true) @map("is_active")
  createdById    String        @map("created_by_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User            @relation(fields: [createdById], references: [id])
  variables      AgentVariable[]
  workflowSteps  WorkflowStep[]

  @@index([organizationId])
  @@map("agents")
}

enum ModelProvider {
  OPENAI
  ANTHROPIC
  AZURE
  GOOGLE
  CUSTOM
}

// ============================================================
// AgentVariable
// ============================================================
model AgentVariable {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentId      String  @map("agent_id") @db.Uuid
  name         String
  description  String?
  defaultValue String? @map("default_value")

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@map("agent_variables")
}

// ============================================================
// Workflow
// ============================================================
model Workflow {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String
  description    String?      @db.Text
  triggerType   TriggerType  @default(MANUAL) @map("trigger_type")
  triggerConfig Json         @default("{}") @map("trigger_config")
  isActive      Boolean      @default(true) @map("is_active")
  createdById   String       @map("created_by_id") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy   User            @relation(fields: [createdById], references: [id])
  steps       WorkflowStep[]
  executions  Execution[]

  @@index([organizationId])
  @@map("workflows")
}

enum TriggerType {
  MANUAL
  WEBHOOK
  SCHEDULE
  API
}

// ============================================================
// WorkflowStep
// ============================================================
model WorkflowStep {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflowId    String  @map("workflow_id") @db.Uuid
  order         Int     @default(0)
  agentId       String  @map("agent_id") @db.Uuid
  name          String
  inputMapping  Json    @default("{}") @map("input_mapping")
  condition     Json?   // Optional: if/else logic based on previous step output
  timeoutSeconds Int   @default(120) @map("timeout_seconds")

  workflow       Workflow      @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  agent         Agent         @relation(fields: [agentId], references: [id])
  executionSteps ExecutionStep[]

  @@index([workflowId])
  @@map("workflow_steps")
}

// ============================================================
// Execution
// ============================================================
model Execution {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflowId     String         @map("workflow_id") @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  triggeredById  String?        @map("triggered_by_id") @db.Uuid
  triggerType    TriggerType
  status         ExecutionStatus @default(QUEUED)
  startedAt      DateTime?      @map("started_at")
  completedAt    DateTime?     @map("completed_at")
  totalTokens    BigInt         @default(0) @map("total_tokens")
  totalCostUsd   Decimal        @default(0) @db.Decimal(10, 6) @map("total_cost_usd")
  errorMessage   String?        @map("error_message") @db.Text
  createdAt      DateTime      @default(now()) @map("created_at")

  workflow      Workflow        @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  organization  Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  triggeredBy   User?           @relation(fields: [triggeredById], references: [id])
  steps        ExecutionStep[]

  @@index([workflowId])
  @@index([organizationId])
  @@index([status])
  @@map("executions")
}

enum ExecutionStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

// ============================================================
// ExecutionStep
// ============================================================
model ExecutionStep {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  executionId    String         @map("execution_id") @db.Uuid
  workflowStepId String         @map("workflow_step_id") @db.Uuid
  order          Int            @default(0)
  status         StepStatus     @default(PENDING)
  input          Json           @default("{}")
  output         Json?          @db.Json
  tokensUsed     Int            @default(0) @map("tokens_used")
  costUsd        Decimal        @default(0) @db.Decimal(8, 6) @map("cost_usd")
  startedAt      DateTime?      @map("started_at")
  completedAt    DateTime?      @map("completed_at")
  errorMessage   String?        @map("error_message") @db.Text
  logs           Json           @default("[]")

  execution    Execution    @relation(fields: [executionId], references: [id], onDelete: Cascade)
  workflowStep WorkflowStep @relation(fields: [workflowStepId], references: [id])

  @@index([executionId])
  @@map("execution_steps")
}

enum StepStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

// ============================================================
// ApiKey
// ============================================================
model ApiKey {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  keyHash        String    @map("key_hash")
  lastUsedAt     DateTime? @map("last_used_at")
  expiresAt      DateTime? @map("expires_at")
  createdById    String    @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy   User         @relation(fields: [createdById], references: [id])

  @@index([organizationId])
  @@map("api_keys")
}

// ============================================================
// AuditLog
// ============================================================
model AuditLog {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId        String?   @map("user_id") @db.Uuid
  action        String
  resourceType  String    @map("resource_type")
  resourceId   String?   @map("resource_id") @db.Uuid
  metadata      Json     @default("{}")
  createdAt    DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}
